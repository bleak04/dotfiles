// -*- mode: jsonc -*-
[{
    "output": ["DP-1", "DP-2"],
    "height": 30,
    "spacing": 4,

    // =========================================================================
    // BAR LAYOUT ORDER
    // =========================================================================
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/mode"
    ], 
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "mpris",
        "idle_inhibitor",
        "custom/gpu",
        "custom/cpu",
        "memory",
        "network",
        "wireplumber",
        "clock",
        "tray"
    ],

    // =========================================================================
    // LEFT MODULES
    // =========================================================================

    "hyprland/workspaces": {
        "all-outputs": true,
        "warp-on-scroll": false,
        "enable-bar-scroll": true,
        "disable-scroll-wraparound": true,
        "format": "{icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "9": "",
            "10": ""
        }
    },

    "hyprland/mode": {
        "format": "{}"
    },

    // =========================================================================
    // CENTER MODULES
    // =========================================================================

    "hyprland/window": {
        "format": "{title}",
        "max-length": 70,
        "separate-outputs": true,
        "all-outputs": false
    },

    // =========================================================================
    // RIGHT MODULES
    // =========================================================================

    "mpris": {
        "format": " {status_icon} {dynamic}",
        "interval": 1,
        "dynamic-len": 35,
        "status-icons": {
            "playing": "▶",
            "paused": "⏸",
            "stopped": ""
        },
        "dynamic-order": ["title", "artist"],
        "ignored-players": ["firefox"],
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous"
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰒳",
            "deactivated": "󰒲"
        },
        "tooltip": true,
        "tooltip-format-activated": "Idle Inhibitor: Active (Sleep Prevented)",
        "tooltip-format-deactivated": "Idle Inhibitor: Inactive"
    },

    "custom/gpu": {
        "exec": "temp=$(cat /sys/class/drm/card*/device/hwmon/hwmon*/temp1_input 2>/dev/null | head -n 1); echo \"GPU $((temp/1000))°C\"",
        "interval": 5,
        "tooltip": true,
        "tooltip-format": "AMD Radeon RX 7900 XTX\nArchitecture: RDNA 3 | VRAM: 24GB GDDR6",
        "on-click": "alacritty -e nvtop"
    },

    "custom/cpu": {
        "exec": "usage=$(top -bn1 | grep 'Cpu(s)' | awk '{print int(100 - $8)}'); temp_raw=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || cat /sys/class/hwmon/hwmon*/temp1_input 2>/dev/null | head -n 1); temp=$((temp_raw > 1000 ? temp_raw / 1000 : temp_raw)); echo \" ${usage}% | ${temp}°C\"",
        "interval": 2,
        "tooltip": true,
        "tooltip-format": "AMD Ryzen 9 7950X\n16 Cores / 32 Threads | Zen 4",
        "on-click": "alacritty -e btop"
    },

    "memory": {
        "format": " {percentage}%",
        "interval": 2,
        "states": {
            "warning": 75,
            "critical": 90
        },
        "tooltip": true,
        "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)",
        "on-click": "alacritty -e btop"
    },

    "network": {
        "format-ethernet": "󰈀 {ipaddr}",
        "format-wifi": "󰤨 {essid}",
        "format-disconnected": "󰤮 Disconnected",
        "tooltip-format": "Interface: {ifname}\nIP: {ipaddr}/{cidr}\nSpeed: 󰕒 {bandwidthUpBits} | 󰇚 {bandwidthDownBits}",
        "interval": 5
    },

    "wireplumber": {
        "scroll-step": 2,
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}% ",
        "format-bluetooth-muted": " {icon}",
        "format-muted": " Muted",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },

    "clock": {
        "format": " {:%H:%M}",
        "format-alt": " {:%Y-%m-%d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "tray": {
        "icon-size": 14,
        "spacing": 10
    }
}]
