{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ASCII/bruh.txt",
    "color": {
      "1": "blue",
      "2": "bright_blue"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "color": {
      "keys": "blue",
      "title": "bright_blue"
    },
    "separator": " ❯ "
  },
  "modules": [
    // --- USER & HOST HEADER ---
    {
      "type": "title",
      "color": {
        "user": "bright_blue",
        "at": "white",
        "host": "blue"
      }
    },
    {
      "type": "custom",
      "format": "────────────────────────────────────────",
      "outputColor": "black"
    },

    // --- SECTION: SYSTEM ---
    {
      "type": "custom",
      "format": "               󰋜 SYSTEM",
      "outputColor": "bright_cyan"
    },
    {
      "type": "os",
      "key": "  󰣇 OS          ",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "  󰌽 Kernel      ",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "  󰅐 Uptime      ",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "  󰏖 Packages    ",
      "keyColor": "blue"
    },

    {
      "type": "custom",
      "format": "────────────────────────────────────────",
      "outputColor": "black"
    },

    // --- SECTION: ENVIRONMENT ---
    {
      "type": "custom",
      "format": "             󰍹 ENVIRONMENT",
      "outputColor": "bright_cyan"
    },
    {
      "type": "wm",
      "key": "  󰨇 WM          ",
      "keyColor": "blue"
    },
    {
      "type": "display",
      "key": "  󰍹 Display     ",
      "keyColor": "blue",
      "compactType": "none",
      "format": "({name}) ❯ {width}x{height} @ {refresh-rate}Hz"
    },
    {
      "type": "terminal",
      "key": "   Terminal    ",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "  󰞷 Shell       ",
      "keyColor": "blue"
    },

    {
      "type": "custom",
      "format": "────────────────────────────────────────",
      "outputColor": "black"
    },

    // --- SECTION: HARDWARE ---
    {
      "type": "custom",
      "format": "               HARDWARE",
      "outputColor": "bright_cyan"
    },
    {
      "type": "cpu",
      "key": "   CPU         ",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "key": "  󰢮 GPU         ",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "key": "  󰍛 Memory      ",
      "keyColor": "blue"
    },
    {
      "type": "disk",
      "key": "  󰋊 Storage     ",
      "keyColor": "blue",
      "folders": "/"
    },

    {
      "type": "custom",
      "format": "────────────────────────────────────────",
      "outputColor": "black"
    },

    // --- SECTION: NETWORK ---
    {
      "type": "custom",
      "format": "               󰛳 NETWORK",
      "outputColor": "bright_cyan"
    },
    {
      "type": "localip",
      "key": "  󰩟 Local IP    ",
      "keyColor": "blue",
      "showIpv6": false,
      "showMac": false
    },
    {
      "type": "media",
      "key": "  󰝚 Now Playing ",
      "keyColor": "blue",
      "format": "\u001b[38;2;29;185;84m{3} - {1}\u001b[0m"
    },

    {
      "type": "custom",
      "format": "────────────────────────────────────────",
      "outputColor": "black"
    },

    // --- COLOR PALETTE PILLS ---
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}

