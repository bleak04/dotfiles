[global]
    ### Display & Dynamic Mouse Follow ###
    # Follows active monitor based on mouse cursor position
    follow = mouse

    # Anchor to top-right corner
    origin = top-right

    # Offset tuned for 1440p (X = 24px right margin, Y = 44px top margin below Waybar)
    offset = (24, 44)

    # Dynamic notification pill dimensions (min-width, max-width)
    width = (280, 380)
    height = (0, 150)

    # Capsule spacing, padding, and borders
    padding = 12
    horizontal_padding = 14
    separator_height = 2
    separator_color = frame
    frame_width = 1
    corner_radius = 10

    ### Typography & Layout ###
    font = JetBrainsMono Nerd Font 10
    line_height = 2
    format = "<b>%a</b>\n<b>%s</b>\n%b"
    alignment = left
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48

    ### Behavior & History ###
    sort = yes
    indicate_hidden = yes
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    shrink = no
    idle_threshold = 120
    sticky_history = yes
    history_length = 20
    show_indicators = no
    browser = /usr/bin/firefox -new-tab

    ### Shortcuts ###
    close = ctrl+space
    close_all = ctrl+shift+space
    history = mod1+grave

# ==============================================================================
# TOKYO NIGHT MATTE COLOR SCHEME
# ==============================================================================

[urgency_low]
    background = "#16161E"
    foreground = "#565F89"
    frame_color = "#2F354F"
    timeout = 6

[urgency_normal]
    background = "#1F2335"
    foreground = "#C0CAF5"
    frame_color = "#7AA2F7"
    timeout = 10

[urgency_critical]
    background = "#2D1D24"
    foreground = "#F7768E"
    frame_color = "#F7768E"
    timeout = 0
