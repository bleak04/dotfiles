[global]
    # Monitor & Position Setup (1440p Tuned)
    monitor = 0
    follow = mouse
    geometry = "360x80-24+44"
    indicate_replacements = yes
    notification_limit = 5

    # Geometry & Spacing
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    padding = 12
    horizontal_padding = 16
    text_icon_padding = 12
    frame_width = 1
    gap_size = 8
    corner_radius = 12

    # Font
    font = JetBrains Mono Nerd Font 10
    line_height = 3
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center

    # Icons
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    # Colors & Theme (Celestial Blue)
    frame_color = "#3B82F6"
    separator_color = "frame"

[urgency_low]
    background = "#0A0D14"
    foreground = "#E2E8F0"
    frame_color = "#121723"
    timeout = 4

[urgency_normal]
    background = "#0A0D14"
    foreground = "#E2E8F0"
    frame_color = "#3B82F6"
    timeout = 6

[urgency_critical]
    background = "#0A0D14"
    foreground = "#E2E8F0"
    frame_color = "#EF4444"
    timeout = 0
